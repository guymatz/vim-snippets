extends sh

snippet safe "safe bash options"
	# e - script stops on error (return != 0)
	# u - error if undefined variable
	# o pipefail - script fails if one of piped command fails
	# x - output each line (debug)
	set -euo pipefail

# Shebang
snippet #!
	#!/usr/bin/env bash

snippet s#!
	#!/usr/bin/env bash
	set -eu

snippet if
	if [[ $1 ]]; then
		${0:${VISUAL}}
	fi
snippet elif
	elif [[ $1 ]]; then
		${0:${VISUAL}}
snippet wh
	while [[ $1 ]]; do
		${0:${VISUAL}}
	done
snippet until
	until [[ $1 ]]; do
		${0:${VISUAL}}
	done
